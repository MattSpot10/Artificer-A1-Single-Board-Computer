(version 1)

(rule "U8 BGA trace width"
    (condition "A.Reference == 'U8'")
    (constraint track_width (min 0.077mm) (opt 0.077mm) (max 0.077mm))
)

(rule "U8 BGA clearance"
    (condition "A.Reference == 'U8' || B.Reference == 'U8'")
    (constraint clearance (min 0.091mm))
)