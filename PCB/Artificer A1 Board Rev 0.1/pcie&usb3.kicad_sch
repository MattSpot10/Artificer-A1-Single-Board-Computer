	(text "A1_PRSNT#1:\nThere is no dedicated pin on the SoC \nto handle card present detection.\n(The card will pull this line low with a \n100ohm resistor) Connect this pin to a GPIO \npin on the SoC supporting inturrput capabilities.\n"
		(exclude_from_sim no)
		(at 203.962 27.686 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "13a7553d-e6b6-4823-931b-729d9d4ec14d")
	)
	(text "This is the System Management I2C or Two Wire interface bus\nIt is used for auxiliary functions between the PCIE and \nthe SoC (power, confic, managment)\nConnect to a I2C(TWI) on the SoC"
		(exclude_from_sim no)
		(at 102.616 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2406fddd-945b-4d25-882d-204cdb98c3d5")
	)
